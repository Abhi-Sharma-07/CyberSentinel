# ============================================================
# Frontend Environment Configuration Template
# Copy this file to .env or .env.local to customize
# ============================================================

# Backend API base URL
# In local dev with Vite proxy, '/api/v1' routes requests to http://127.0.0.1:8000
# In production, point to your deployed backend URL:
# VITE_API_BASE_URL=https://your-api-domain.com/api/v1
VITE_API_BASE_URL=/api/v1

# Target backend host for Vite dev server proxy (defaults to http://127.0.0.1:8000)
VITE_BACKEND_URL=http://127.0.0.1:8000
